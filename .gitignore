# =============================================================
# .gitignore — CareConnect Medication & Wellness Platform
# =============================================================
# Keeps the repository under 10 MB by excluding heavy
# directories and sensitive credential files.
# =============================================================

# ── Node.js / npm / pnpm ─────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment / Secrets (NEVER commit these) ───────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.secret

# ── Build / Distribution outputs ─────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.vite/
coverage/

# ── OS artefacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editor & IDE config ───────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# ── Firebase local emulator & tooling ────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc          # project aliases — may contain project IDs
firebase.json        # optional: exclude if you add it later

# ── Vercel deployment cache ───────────────────────────────────
.vercel

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Jest / testing artefacts ─────────────────────────────────
coverage/
.jest-cache/

# ── Misc large files that should never be committed ──────────
*.zip
*.tar.gz
*.rar
*.mp4
*.mov
